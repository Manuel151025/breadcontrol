# ═══ BreadControl .gitignore ═══

# Archivos de configuración con contraseñas
config/email.php
.env
/test_*.php
fix_*.php
diagnostico_*.php
instalar_phpmailer.php

# Imágenes subidas por usuario
assets/img/variedades/*
!assets/img/variedades/.gitkeep

# Manuales de usuario: SÍ se versionan.
#
# Estaban excluidos como "documentos generados", pero no los genera ningún
# script: son documentos escritos a mano, y la interfaz los enlaza desde cuatro
# sitios (login, portada, portal y back-office). Al no viajar en el repositorio,
# esos cuatro botones devolvían 404 en producción y en cualquier clon nuevo.
# Si algún día se generan automáticamente, se vuelven a ignorar y se publican
# desde el proceso que los genere.

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-*
nbproject/

# Logs
*.log
error_log

# PHP
vendor/
.phpunit.cache/

# Informes de cobertura (se generan; en CI viajan como artefacto)
cobertura/

# SQL (dumps ignorados, pero las migraciones y scripts de init SI se versionan)
*.sql
!sql/migraciones/*.sql
!sql/init/*.sql
# Manifiesto del generador de datos de demostracion (ids locales, no se comparte)
scripts/datos_demo_manifiesto.json
