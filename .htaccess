# Bloquear acceso a archivos de configuración .env
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Bloquear acceso a archivos ocultos (que inician con punto)
RedirectMatch 403 /\..*$

# ============================================================
#  Cabeceras de seguridad
#
#  Responden a las recomendaciones R-03, R-04 y R-05 del informe técnico del
#  2026-08-12. HSTS y ocultar la versión de Nginx no se pueden hacer desde
#  aquí: son del servidor web que está delante (ver LIMITACIONES).
# ============================================================
<IfModule mod_headers.c>
    # No adivinar el tipo de contenido: un archivo servido como imagen no puede
    # acabar ejecutándose como script por el olfato del navegador.
    Header always set X-Content-Type-Options "nosniff"

    # Al salir del sitio se envía solo el origen, nunca la ruta completa: una
    # URL como /portal/detalle_pedido.php?id=24 no debe viajar a terceros.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # El sistema no usa cámara, micrófono ni ubicación: se niegan de entrada.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Respaldo de frame-ancestors para navegadores antiguos.
    Header always set X-Frame-Options "SAMEORIGIN"

    # No anunciar la versión exacta de PHP (ver también expose_php en el Dockerfile).
    Header always unset X-Powered-By

    # ── Content Security Policy ──────────────────────────────────────────
    #
    # Se aplica en modo ACTIVO, no solo de reporte, porque ya bloquea lo que
    # más importa: ningún script, hoja, tipografía o conexión puede venir de
    # un origen que no esté aquí. Un <script src="sitio-atacante"> inyectado
    # no se ejecuta.
    #
    # 'unsafe-inline' sigue siendo necesario y conviene ser explícito sobre por
    # qué: el proyecto tiene 157 manejadores en línea (onclick y similares),
    # 31 bloques <script> incrustados y 779 atributos style. Quitarlo exige
    # extraerlos a archivos o firmarlos con nonce — un trabajo real, no un
    # ajuste de configuración, y está anotado como pendiente.
    #
    # connect-src incluye Open-Meteo, la única API que el navegador consulta.
    # form-action permite Google porque ahí va el acceso con cuenta de Google.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.open-meteo.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'"
</IfModule>

# ============================================================
#  Rendimiento de recursos estáticos
#
#  Antes el servidor no enviaba NI compresión NI cabeceras de caché: cada
#  navegación volvía a pedir todas las hojas de estilo, los scripts y las
#  imágenes, y aunque el servidor respondiera "no ha cambiado", cada archivo
#  costaba una ida y vuelta. Por eso el logo y los fondos aparecían con
#  retraso al entrar.
#
#  Las hojas de estilo y los scripts se enlazan con ?v=APP_VERSION, así que se
#  pueden cachear un año sin miedo: al publicar una versión nueva cambia la
#  URL y el navegador descarga la nueva de inmediato. Las imágenes no llevan
#  versión en la URL, así que se cachean un mes: cambian rara vez y un mes es
#  un plazo razonable para que una imagen reemplazada llegue a todos.
#
#  Los <IfModule> hacen que esto no rompa nada si el módulo no está activo:
#  simplemente no se aplica la mejora.
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    # Los JPG, PNG y PDF ya vienen comprimidos: volver a comprimirlos gasta
    # CPU y no baja el peso.
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Con ?v= en la URL, un año es seguro.
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Sin versión en la URL: un mes.
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType image/x-icon             "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"

    # Los manuales pueden reemplazarse sin cambiar de nombre.
    ExpiresByType application/pdf          "access plus 1 week"

    # El HTML lo genera PHP en cada petición: nunca se cachea.
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # "immutable" evita incluso la petición de revalidación en los navegadores
    # que lo soportan. Solo para lo que lleva versión en la URL.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
</IfModule>
