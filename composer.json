{
    "name": "manuel151025/breadcontrol",
    "description": "BreadControl — Sistema web de gestión para panaderías: inventario, recetas, producción, ventas, finanzas y portal de clientes.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "panaderia",
        "inventario",
        "ventas",
        "php",
        "mysql"
    ],
    "authors": [
        {
            "name": "Manuel Cárdenas Suárez",
            "email": "manuelcardenassuarez2005@gmail.com",
            "role": "Desarrollador"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "infection/infection": "^0.32.6",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^2.11",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "models/",
            "helpers/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite Unitarias --colors=always",
        "test:integracion": "phpunit --testsuite Integracion --colors=always",
        "calidad": "phpmd models,controllers,helpers,includes,config text phpmd.xml --baseline-file phpmd.baseline.xml",
        "calidad:base": "phpmd models,controllers,helpers,includes,config text phpmd.xml --update-baseline",
        "metricas": "phpmetrics --report-html=metricas \"models,controllers,helpers,includes,config\"",
        "mutacion": "infection --threads=4 --min-covered-msi=69 --no-interaction"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
