# Configuración de PHPStan (análisis estático)
# Analiza el código de lógica (modelos, helpers, controladores, config, includes).
# Las vistas (HTML+PHP) quedan fuera: son plantillas, no lógica.
parameters:
    # Nivel 5 pasa limpio (2026-08). Si se quiere subir mas, revisar
    # los hallazgos de nivel 6 (tipos de retorno/parametros sin declarar).
    level: 5
    paths:
        - config
        - controllers
        - helpers
        - includes
        - models
    excludePaths:
        - vendor
    treatPhpDocTypesAsCertain: false
