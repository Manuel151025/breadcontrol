# Configuración de PHPStan (análisis estático)
# Analiza el código de lógica (modelos, helpers, controladores, config, includes).
# Las vistas (HTML+PHP) quedan fuera: son plantillas, no lógica.
parameters:
    # Nivel 3 pasa limpio hoy; al refactorizar los controladores (punto 3)
    # se corrigen los 6 hallazgos del nivel 4 y se puede subir el nivel.
    level: 3
    paths:
        - config
        - controllers
        - helpers
        - includes
        - models
    excludePaths:
        - vendor
    treatPhpDocTypesAsCertain: false
